{
  "name": {{ shop_name | tojson }},
  "short_name": {{ shop_name | tojson }},
  "icons": [
    {
      "src": "{{ url_for('static', filename='favicon/web-app-manifest-192x192.png') }}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "{{ url_for('static', filename='favicon/web-app-manifest-512x512.png') }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "theme_color": "#1C1D21",
  "background_color": "#1C1D21",
  "display": "standalone"
}
